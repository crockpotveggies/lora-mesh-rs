# Local editor and operating-system files
.idea/
*.iml
.DS_Store
._*
Thumbs.db
Desktop.ini

# Cargo builds, test reports, hardware logs and coverage output
/target/
/fuzz/target/
/coverage/
*.profraw
*.profdata

# Keep Cargo.lock and fuzz/Cargo.lock for reproducible builds.
# Keep curated reports in docs/benchmarks and fixtures in tests/fixtures.

# Rustfmt backups
**/*.rs.bk

# Python integration and packaging tools
__pycache__/
*.py[cod]
/.venv/

# Generated fuzz inputs and crash artifacts
/fuzz/artifacts/
/fuzz/corpus/

# Installer staging, packages, archives and checksums
/dist/

# Local deployment configuration, identities and durable runtime state
# Put local node directories under .local/; state is not disposable build output.
/.local/
signing.key
peer-*.key
*.sock

# Local environment overrides and exported signing credentials
.env
.env.*
!.env.example
*.p12
*.pfx
